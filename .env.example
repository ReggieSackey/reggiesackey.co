# ------------------------------------------------------------------
# reggiesackey.co — environment variables
#
# Copy to `.env.local` and fill in real values. Never commit real
# secrets: `.env.local` is gitignored.
# ------------------------------------------------------------------

# --- WorkOS AuthKit -------------------------------------------------
# From the WorkOS Dashboard (https://dashboard.workos.com):
#   Configuration → API Keys.
# Dev credentials use the `client_01…` / `sk_test_…` format.
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=sk_test_replace_me

# Password used to encrypt the AuthKit session cookie.
# Must be at least 32 characters. Generate one:
#   openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where WorkOS redirects after authentication. Must EXACTLY match the
# Redirect URI configured in the WorkOS Dashboard for this environment.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Convex ---------------------------------------------------------
# Frontend URL of the Convex deployment (set automatically by
# `npx convex dev` in `.env.local`; also set on Vercel).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# The deployment `npx convex dev` pushes code and config to. Written by
# the Convex CLI into `.env.local`; do not commit.
CONVEX_DEPLOYMENT=dev:your-deployment

# ------------------------------------------------------------------
# Convex-side (set via `npx convex env set`, NOT in this file):
#   WORKOS_CLIENT_ID  — used by convex/auth.config.ts to validate JWTs.
#     Required for ctx.auth.getUserIdentity() to work server-side.
# ------------------------------------------------------------------

# --- Z.AI (GLM) — server-side only ---------------------------------
# Model calls run in Next.js (route handlers), so these live in
# .env.local locally and in the Vercel project environment in
# production. NEVER prefix these with NEXT_PUBLIC_ and never put the
# key in Convex — the browser must never see it.
#
# ZAI_API_KEY: from your Z.AI account (https://z.ai).
ZAI_API_KEY=

# Base URL of Z.AI's OpenAI-compatible API. The default below is the
# general API endpoint; override only if you know you need another.
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Model name. Default: glm-5.3-flash (adjust to the model your key
# supports).
ZAI_MODEL=glm-5.3-flash

# Reasoning effort for GLM-5.3-family models: low | high | max.
# GLM-5.3-Flash always reasons (thinking cannot be disabled); this
# controls how much. Defaults to low — the cheapest tier — because this
# pipeline runs constrained extraction/evaluation tasks.
ZAI_REASONING_EFFORT=low
